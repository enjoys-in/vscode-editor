# App environment gating.
# Set to DEV to disable the session/param entry checks (local development):
# the editor opens without a tabId/sessionId + path and never blocks.
# Any other value, or unset, means production — the editor requires a valid,
# existing session (tabId or sessionId) and a path; random/missing sessions are
# blocked. Note: Vite only exposes variables prefixed with VITE_.
VITE_APP_ENV=prod

# Backend API base URL used by all plugins.
VITE_API_BASE_URL=http://localhost:7145

# GitHub OAuth App client id (public). Required for GitHub sign-in.
# The client secret stays on your backend, which must implement the callback
# route that exchanges the OAuth code for a token (see GITHUB_CONFIG).
VITE_GITHUB_CLIENT_ID=
